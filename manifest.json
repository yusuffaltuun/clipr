{
  "manifest_version": 3,
  "name": "Clipr",
  "description": "Browser video clipper - Crop and download video segments instantly",
  "version": "1.6.4",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
